# TEST BRANCH ONLY (claude/youtube-search-dry-run) — the YouTube search dry run, never merged.
# Bundled with esbuild exactly like the worker (dist/worker.js), because the server's module graph
# has import cycles that only a bundle orders the way production runs them.
FROM node:22-slim
RUN apt-get update && apt-get install -y ffmpeg python3 make g++ \
  libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@10
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN pnpm install --no-frozen-lockfile
COPY . .
RUN npx esbuild scripts/youtubeSearchDryRun.ts --platform=node --packages=external --bundle --format=esm --outfile=scripts/youtubeSearchDryRun.bundle.mjs
CMD ["node", "scripts/youtubeSearchDryRun.bundle.mjs"]
